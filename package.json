{
  "name": "pi-cross-session",
  "version": "2.2.1",
  "description": "Pi ↔ Pi same-machine cross-session messaging: discover live sessions and exchange plain-text peer messages over per-instance IPC (Unix socket / named pipe)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "ipc",
    "cross-session"
  ],
  "license": "MIT",
  "author": "gcoder1991",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcoder1991/pi-cross-session.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "lib",
    "test",
    "tsconfig.json",
    "HANDOFF.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.25",
    "typescript": "^5.7.0"
  }
}
